# ---- Backend (apps/api) ----
# SQLite fallback is used when unset; point at PostgreSQL for production.
# DATABASE_URL=postgresql://scamshield:scamshield@localhost:5432/scamshield
DATABASE_URL=sqlite:///./scamshield.db

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Demo-only investigator token (NOT production auth — documented limitation).
INVESTIGATOR_DEMO_TOKEN=demo-investigator

# Optional: enables real Whisper transcription for audio uploads.
# The demo works fully without it (a clearly-labelled mock transcript is used).
# OPENAI_API_KEY=sk-...

# Upload limits
MAX_UPLOAD_BYTES=8388608

# ---- Frontend (apps/web/.env.local) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
